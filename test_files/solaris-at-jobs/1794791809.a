: at job
: jobname: stdin
: notify by mail: no
: project: 3
export SHELL; SHELL='/bin/bash'
export PWD; PWD='/home/omnios'
export LOGNAME; LOGNAME='omnios'
export TZ; TZ='UTC'
export HOME; HOME='/root'
export LANG; LANG='en_US.UTF-8'
export SSH_CONNECTION; SSH_CONNECTION='10.0.2.2 49112 10.0.2.15 22'
export USER; USER='omnios'
export SHLVL; SHLVL='2'
export SSH_CLIENT; SSH_CLIENT='10.0.2.2 49112 22'
export PATH; PATH='/usr/bin:/usr/sbin:/sbin:/opt/ooce/bin:/usr/gnu/bin'
export A__z; A__z='"*SHLVL'
export _; _='/usr/bin/at'
$SHELL << '...the rest of this file is shell input'
